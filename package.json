{
  "name": "cores-com-dicas",
  "version": "1.0.0",
  "description": "Jogo web multiplayer local de Cores com Dicas (Hues and Cues)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "start-server-and-test 'node server.js' http://localhost:3000/player 'cypress run'",
    "test:e2e:open": "start-server-and-test 'node server.js' http://localhost:3000/player 'cypress open'"
  },
  "keywords": [
    "hues-and-cues",
    "color-game",
    "multiplayer",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.5.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "cypress": "^15.15.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.5",
    "start-server-and-test": "^2.0.8",
    "supertest": "^7.0.0"
  }
}
